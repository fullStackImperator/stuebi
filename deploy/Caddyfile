# HTTPS in front of the app. Caddy gets and renews the certificates itself.
# No `log` directive on purpose: visits are not logged (Datenschutz page, "Server-Protokolle").
# Request errors (mostly visitors closing a connection) would log the visitor's IP, so they are left out too;
# messages about certificates and Caddy itself stay.
{
	log default {
		output stderr
		exclude http.log.error
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
	reverse_proxy app:3000
}

# www leads to the address without www (since the move on 19.11.2026, docs/umzug.md).
www.stuebi-hamburg.de {
	redir https://stuebi-hamburg.de{uri} permanent
}
